# Database Configuration
# For Neon serverless PostgreSQL, use your connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database

# Server Configuration
PORT=5000
NODE_ENV=production

# Session Configuration (if needed)
SESSION_SECRET=change-this-to-a-random-secret-key

# Optional: If using local PostgreSQL with docker-compose
# DATABASE_URL=postgresql://portfolio_user:portfolio_password@postgres:5432/portfolio
